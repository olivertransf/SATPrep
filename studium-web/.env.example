# Copy to .env.local (gitignored). Get keys from Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Option A — recommended: one Supabase Auth user (create in Authentication → Users).
# App shows only a password field; email stays in env.
VITE_SYNC_EMAIL=you@example.com

# Option B — gate only (no Supabase user): password unlocks sync to row id = "default".
# Do not set VITE_SYNC_EMAIL if using this.
# VITE_SYNC_GATE_PASSWORD=your-secret
